  "audit_script_source": "\"\"\"Independent reference construction audit: CPU only, no image inference.\"\"\"\nimport contextlib\nimport importlib.metadata\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nROOT = Path('/mnt/sdab1/userHome/wslim/.codex/worktrees/aa40/compression-gap-cl/.worktrees/ease-sizes')\nSOURCE = Path('/tmp/cl-ease-official-20261007')\nsys.path.insert(0, str(ROOT))\nfrom scripts.cl_runtime import configure_environment\nconfigure_environment()\nos.environ['CUDA_VISIBLE_DEVICES'] = ''\nos.environ['HF_HUB_OFFLINE'] = '1'\nfrom scripts.ease_size_protocol import load_variant, canonical_pretrained_state, canonical_pretrained_digest, file_hash\nfrom scripts.ease_reference_utils import install_reference_patches\nfrom scripts.run_ease_reference import isolate_reference_imports, audit_variant_initialization, REFERENCE_COMMIT\n\nimport torch\nimport timm\ntorch.set_num_threads(2)\ntorch.set_default_dtype(torch.float32)\nname, output = sys.argv[1], Path(sys.argv[2])\nvariant = load_variant(name)\ncommit = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=SOURCE, capture_output=True, text=True, check=True).stdout.strip()\nif commit != REFERENCE_COMMIT:\n    raise RuntimeError('Read-only reference commit changed')\nif subprocess.run(['git', 'status', '--porcelain'], cwd=SOURCE, capture_output=True, text=True, check=True).stdout.strip():\n    raise RuntimeError('Read-only reference source changed')\n\nisolate_reference_imports(SOURCE)\nfrom utils import data, data_manager, inc_net\nfrom backbone import vit_ease\nfrom models import ease\nmodules = {'timm': timm, 'data': data, 'data_manager': data_manager, 'inc_net': inc_net, 'vit': vit_ease, 'ease': ease}\nrecords = {}\nconfig = json.loads((SOURCE / 'exps/ease_cifar.json').read_text())\nconfig.update(device=[torch.device('cpu')], ffn_num=variant['adapter_size'])\nwith install_reference_patches(modules, variant['checkpoint_file'], '/mnt/sdab1/share/data', records, variant=variant):\n    backbone = inc_net.get_backbone(config, pretrained=True)\n    digest = audit_variant_initialization(backbone, variant)\n    state = canonical_pretrained_state(backbone)\n    checks = {'cpu_only': all(parameter.device.type == 'cpu' for parameter in backbone.parameters()),\n              'canonical_tensor_count_150': len(state) == 150,\n              'canonical_pretrained_matches_pin': digest == variant['canonical_pretrained_sha256'],\n              'checkpoint_sha256_matches_pin': file_hash(variant['checkpoint_file']) == variant['checkpoint_sha256'],\n              'canonical_fp32_finite': all(tensor.dtype == torch.float32 and torch.isfinite(tensor).all().item() for tensor in state.values()),\n              'strict_pretrained_keys': bool(records.get('converted_checkpoint_audits')) and all(not audit['unexpected_keys']\n                    and all(key.startswith('cur_adapter.') for key in audit['missing_adapter_keys'])\n                    for audit in records['converted_checkpoint_audits']),\n              'source_namespace_isolated': all(Path(module.__file__).resolve().is_relative_to(SOURCE)\n                    for module in (data, data_manager, inc_net, vit_ease, ease)),\n              'cuda_not_initialized': not torch.cuda.is_initialized()}\n    report = {'variant': name, 'status': 'pass' if all(checks.values()) else 'fail', 'checks': checks,\n              'reference_kind': 'author-code-size-variant', 'reference_commit': commit, 'variant_config': variant,\n              'initial_canonical_pretrained_sha256': digest, 'blocks': len(backbone.blocks),\n              'feature_dim': backbone.out_dim, 'num_heads': [block.attn.num_heads for block in backbone.blocks],\n              'adapter_down_shapes': [list(layer.down_proj.weight.shape) for layer in backbone.cur_adapter],\n              'adapter_up_shapes': [list(layer.up_proj.weight.shape) for layer in backbone.cur_adapter],\n              'registered_parameters': sum(parameter.numel() for parameter in backbone.parameters()),\n              'trainable_parameters': sum(parameter.numel() for parameter in backbone.parameters() if parameter.requires_grad),\n              'versions': {package: importlib.metadata.version(package) for package in ('torch', 'timm', 'numpy')},\n              'runtime_patches': records, 'image_forward_calls': 0, 'gpu_execution': False, 'downloads': False}\n    output.write_text(json.dumps(report, indent=2, allow_nan=False) + '\\n')\n    if report['status'] != 'pass':\n        raise RuntimeError('CPU reference construction audit failed')\nprint(json.dumps({'variant': name, 'status': report['status'], 'feature_dim': backbone.out_dim,\n                  'adapter_size': variant['adapter_size'], 'canonical_sha256': digest}))\n",
